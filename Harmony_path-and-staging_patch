def print_help() -> int:
  print(__doc__.strip())
  return 0

def tolerant(old: str):
  """A pattern for old that ignores spaces and tabs at the ends of lines."""
  lines = old.split("\n")
  last = len(lines) - 1
  return re.compile("\n".join(
    re.escape(l.rstrip(" \t")) + ("" if i == last and l == "" else "[ \t]*")
    for i ,l in enumerate(lines)
  ))

def plan(root: Path):
  """Returns (new_texts ,already ,problems). new_texts maps a path to its new
  text; already lists the files that are already patched."""
  new_texts = {}
  already = []
  problems = []
  for rel ,edits in EDITS.items():
    f = root / rel
    if not f.is_file():
      problems.append(f"{rel}: file not found")
      continue
    text = f.read_text(encoding="utf-8")
    applied = 0
    for n ,(old ,new) in enumerate(edits ,1):
      # The finished form is checked first: an edit's old text can lie
      # inside its new text, and would otherwise be applied twice.
      if new != "" and len(tolerant(new).findall(text)) == 1:
        applied += 1
        continue
      count = len(tolerant(old).findall(text))
      if count == 1:
        text = tolerant(old).sub(lambda m: new ,text)
        continue
      if new == "" and count == 0:
        applied += 1
        continue
      problems.append(f"{rel}: edit {n}: expected text found {count} times, not once")
    if applied == len(edits):
      already.append(rel)
    elif applied:
      problems.append(f"{rel}: partly patched ({applied} of {len(edits)} edits already present)")
    else:
      new_texts[rel] = text
  return new_texts ,already ,problems

def work(root: Path ,preview: bool) -> int:
  print(f"Harmony_path-and-staging_patch {'preview' if preview else 'apply'}   in {root}")
  new_texts ,already ,problems = plan(root)
  if problems:
    for p in problems: print(f"  error           {p}")
    print("Nothing was changed.")
    return 1
  for rel in already:
    print(f"  already patched {rel}")
  for rel ,text in new_texts.items():
    f = root / rel
    if preview:
      print(f"  would change    {rel}  ({len(EDITS[rel])} edits)")
    else:
      mode = f.stat().st_mode
      f.write_text(text ,encoding="utf-8")
      f.chmod(mode)
      print(f"  changed         {rel}  ({len(EDITS[rel])} edits)")
  if preview: print("preview only: nothing was changed")
  return 0

def CLI(argv=None) -> int:
  if argv is None: argv = sys.argv[1:]
  if not argv or argv[0] in ("help" ,"-h" ,"--help"): return print_help()
  if len(argv) != 1 or argv[0] not in ("preview" ,"apply"):
    print(f"Error: unknown command '{' '.join(argv)}'.\n" ,file=sys.stderr)
    print_help()
    return 1
  root = Path.cwd()
  if not (root / "shared" / "tool" / "setup").is_file():
    print("Error: run this from the top directory of the project." ,file=sys.stderr)
    return 1
  return work(root ,argv[0] == "preview")

if __name__ == "__main__":
  sys.exit(CLI())
