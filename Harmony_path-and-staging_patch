#!/usr/bin/env python3
# -*- mode: python; coding: utf-8; python-indent-offset: 2; indent-tabs-mode: nil -*-

"""
Harmony_path-and-staging_patch

One-time patch for the Harmony skeleton. Run it from the top directory of
the project, after checkpointing with git.

  1. shared/tool/setup
     Sources the project dependency .init files first, then adds shared/tool,
     shared/made, shared/authored, so the search order becomes
     shared/authored, shared/made, shared/tool, project dependencies.
  2. setup
     Adds the role's tool directory after the shared setup has run, so it is
     searched before everything else. Removes the earlier PATH injection,
     which put it behind the shared directories.
  3. developer/tool/build_component/copy
     Stages into scratchpad/made/<namespace>, like the make component.
  4. developer/tool/promote
     Copies from scratchpad/made into consumer/, so build intermediates
     such as scratchpad/build/object stay on the scratchpad. Its setup hint
     now says ./setup developer.

Every expected piece of text is checked before any file is written. If one
is missing, the patch reports it and changes nothing.

Usage: Harmony_path-and-staging_patch <command>
  help | -h | --help   print this message (also printed when given no arguments)
  preview              print what would change, change nothing
  apply                make the changes
"""

import sys ,re
from pathlib import Path

EDITS = {
  "shared/tool/setup": [
    (
'''# --------------------------------------------------------------------------------
# PATH & Plugin Sourcing
#   precedence: last defined, first discovered

  PATH="$REPO_HOME/shared/authored:$PATH"
  PATH="$REPO_HOME/shared/made:$PATH"
  PATH="$REPO_HOME/shared/tool:$PATH"

  # Remove duplicates
  clean_path() {
    PATH=$(echo ":$PATH" | awk -v RS=: -v ORS=: '!seen[$0]++' | sed 's/^://; s/:$//')
  }
  clean_path

  # Plugin Sourcing: Dynamically load all the linked project configurations
  for init_file in "$REPO_HOME/shared/project-dependency/"*.init; do
    if [[ -f "$init_file" ]]; then
      source "$init_file"
    fi
  done
'''
