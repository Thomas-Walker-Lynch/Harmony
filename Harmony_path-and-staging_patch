#   Resulting search order, most specific first:
#     shared/authored, shared/made, shared/tool, project dependencies, the rest.
#   The top-level setup then puts the role's tool directory in front of these.

  # Project dependencies: source each .init file. Each prepends its own entries.
  for init_file in "$REPO_HOME/shared/project-dependency/"*.init; do
    if [[ -f "$init_file" ]]; then
