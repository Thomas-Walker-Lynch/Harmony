'''
    )
  ]
  ,"setup": [
    (
'''    # Python-domain logic: PATH injection
    path_parts = env.get("PATH", "").split(os.pathsep)
    if tool_dir not in path_parts:
        env["PATH"] = f"{tool_dir}{os.pathsep}{env.get('PATH', '')}"

'''
    ,
''
    )
    ,(
"""        'if [[ -f "shared/authored/setup" ]]; then source "shared/authored/setup"; fi',
"""
    ,
"""        'if [[ -f "shared/authored/setup" ]]; then source "shared/authored/setup"; fi',
        '# the role tool directory is searched before everything the shared setup added',
        f'PATH="{tool_dir}:$PATH"; export PATH',
"""
    )
  ]
  ,"developer/tool/build_component/copy": [
    ('all     Stages files from authored to scratchpad.'
     ,'all     Stages files from authored to scratchpad/made/<namespace>.')
    ,('clean   Removes the specified namespace from scratchpad.'
     ,'clean   Removes scratchpad/made/<namespace>.')
    ,('''  src_root = os.path.join("authored", namespace_dir)
  dst_root = os.path.join("scratchpad", namespace)'''
     ,'''  src_root = os.path.join("authored", namespace_dir)
  dst_root = os.path.join("scratchpad", "made", namespace)''')
    ,('''  dst_root = os.path.join("scratchpad", namespace)
  if os.path.exists(dst_root):'''
     ,'''  dst_root = os.path.join("scratchpad", "made", namespace)
  if os.path.exists(dst_root):''')
  ]
  ,"developer/tool/promote": [
    ('write       Writes promoted files from scratchpad into consumer. Only updates newer files.'
     ,'write       Copies what is staged in scratchpad/made into consumer. Only updates newer files.')
    ,('diff        List missing, orphaned, or out of sync files between scratchpad and consumer.'
     ,'diff        List missing, orphaned, or out of sync files between scratchpad/made and consumer.')
    ,('"Enter the project with:  . setup developer\\n"'
     ,'"Enter the developer role with:  ./setup developer\\n"')
    ,('''  ensure_dir(dst_root, DEFAULT_DIR_MODE, dry=dry)
  src_root = dpath("scratchpad")'''
     ,'''  ensure_dir(dst_root, DEFAULT_DIR_MODE, dry=dry)
  src_root = dpath("scratchpad", "made")''')
    ,('''  dst_root = cpath()
  src_root = dpath("scratchpad")

